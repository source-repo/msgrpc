{
  "name": "@source-repo/msgrpc-cli",
  "version": "2.5.0",
  "description": "Extracts an msgrpc contract from TypeScript source, checks it for breaking changes, and browses a live network in a browser",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18.17"
  },
  "bin": {
    "msgrpc": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/fixture"
  ],
  "scripts": {
    "build": "vite build --config web/vite.config.ts && tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "postbuild": "node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run clean && npm run build && ava",
    "prepack": "npm run clean && npm run build",
    "contract": "npm run contract:console && npm run contract:bus && npm run contract:chat && npm run contract:msgrpc",
    "contract:console": "node dist/index.js extract --project tsconfig.contract.json --out src/console.types.json",
    "contract:bus": "node dist/index.js extract --project tsconfig.bus.json --out src/bus.types.json",
    "contract:chat": "node dist/index.js extract --project web/tsconfig.contract.json --out web/src/chat.types.json",
    "contract:msgrpc": "node dist/index.js extract --project ../msgrpc/tsconfig.contract.json --out ../msgrpc/src/RPC/Introspection.types.json",
    "check:contract": "npm run check:contract:console && npm run check:contract:bus && npm run check:contract:chat && npm run check:contract:msgrpc",
    "check:contract:console": "node dist/index.js check --project tsconfig.contract.json --against src/console.types.json",
    "check:contract:bus": "node dist/index.js check --project tsconfig.bus.json --against src/bus.types.json",
    "check:contract:chat": "node dist/index.js check --project web/tsconfig.contract.json --against web/src/chat.types.json",
    "check:contract:msgrpc": "node dist/index.js check --project ../msgrpc/tsconfig.contract.json --against ../msgrpc/src/RPC/Introspection.types.json",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts"
  },
  "dependencies": {
    "@source-repo/msgrpc": "^2.4.0",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "ava": "^8.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/source-repo/msgrpc.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/source-repo/msgrpc/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/source-repo/msgrpc/issues"
  }
}
