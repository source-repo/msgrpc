{
  "name": "@source-repo/msgrpc-cli",
  "version": "2.0.0",
  "description": "Extracts an msgrpc contract from TypeScript source and checks it for breaking changes",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=18.17" },
  "bin": { "msgrpc": "./dist/index.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "!dist/**/*.test.*", "!dist/fixture"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run clean && npm run build && ava"
  },
  "dependencies": {
    "@source-repo/msgrpc": "^2.0.0",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "ava": "^6.1.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  }
}
