{
    "name": "@source-repo/queue",
    "version": "0.2.0",
    "description": "A lease-based work queue for Source RPC networks: at-least-once, bounded, transport-neutral over socket.io and MQTT 5",
    "keywords": [
        "queue",
        "work-queue",
        "rpc",
        "mqtt",
        "socket.io",
        "typescript"
    ],
    "type": "module",
    "license": "MIT",
    "author": "anderswestberg",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/source-repo/rpc.git",
        "directory": "packages/queue"
    },
    "engines": {
        "node": ">=22"
    },
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "!dist/**/*.test.*"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "clean": "rimraf dist",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "npm run clean && npm run build && ava",
        "prepack": "npm run clean && npm run build"
    },
    "dependencies": {
        "@source-repo/rpc": "^4.3.0",
        "uuid": "^14.0.1"
    },
    "devDependencies": {
        "@types/node": "^26.1.2",
        "ava": "^8.0.1",
        "mqtt": "^5.10.1",
        "rimraf": "^6.0.1",
        "typescript": "^7.0.2"
    },
    "ava": {
        "files": [
            "dist/**/*.test.js"
        ],
        "workerThreads": false,
        "concurrency": 1
    },
    "homepage": "https://github.com/source-repo/rpc/tree/main/packages/queue#readme",
    "bugs": {
        "url": "https://github.com/source-repo/rpc/issues"
    }
}
