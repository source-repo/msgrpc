{
    "name": "@source-repo/sparkplug",
    "version": "0.1.0",
    "description": "Sparkplug B integration for Source RPC: Edge Node session substrate, projection, ingestion and controlled commands",
    "keywords": [
        "sparkplug",
        "sparkplug-b",
        "mqtt",
        "rpc",
        "typescript"
    ],
    "type": "module",
    "license": "MIT",
    "author": "anderswestberg",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/source-repo/rpc.git",
        "directory": "packages/sparkplug"
    },
    "engines": {
        "node": ">=22"
    },
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./sparkplug.projection.schema.json": "./sparkplug.projection.schema.json",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "proto",
        "sparkplug.projection.schema.json",
        "NOTICE",
        "!dist/**/*.test.*"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "clean": "rimraf dist",
        "proto:generate": "protoc --proto_path proto --es_out src/generated --es_opt target=ts,import_extension=js proto/sparkplug_b.proto",
        "proto:check": "npm run proto:generate && git diff --exit-code -- src/generated",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "npm run clean && npm run build && ava",
        "prepack": "npm run clean && npm run build"
    },
    "dependencies": {
        "@bufbuild/protobuf": "^2.13.0",
        "@source-repo/rpc": "^4.6.0",
        "mqtt": "^5.15.2"
    },
    "devDependencies": {
        "@bufbuild/protoc-gen-es": "^2.13.0",
        "@types/node": "^26.1.2",
        "ava": "^8.0.1",
        "rimraf": "^6.0.1",
        "typescript": "^7.0.2"
    },
    "ava": {
        "files": [
            "dist/**/*.test.js"
        ],
        "workerThreads": false,
        "concurrency": 1
    },
    "homepage": "https://github.com/source-repo/rpc/tree/main/packages/sparkplug#readme",
    "bugs": {
        "url": "https://github.com/source-repo/rpc/issues"
    }
}
